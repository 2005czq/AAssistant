{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "types": ["svelte"],
    "moduleResolution": "bundler",
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "module": "ESNext",
    "target": "ES2020",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.svelte"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
